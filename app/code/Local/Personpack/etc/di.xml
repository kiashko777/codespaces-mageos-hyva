<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Register personpack fee as a sales total -->
    <type name="Magento\Quote\Model\Quote\TotalsCollector">
        <arguments>
            <argument name="totalCollectors" xsi:type="array">
                <item name="personpack_fee" xsi:type="object">Local\Personpack\Model\Quote\Total\PersonpackFee</item>
            </argument>
        </arguments>
    </type>

    <!-- Copy personpack data from quote item to order item on conversion -->
    <type name="Magento\Quote\Model\Quote\Item\ToOrderItem">
        <plugin name="local_personpack_save_to_order_item"
                type="Local\Personpack\Plugin\SavePersonpackToOrderItem"/>
    </type>

</config>
